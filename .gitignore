# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local secrets and environment overrides
.env
.env.*
!.env.example

# Generated research state and artifacts
storage/data/*
storage/reports/*
storage/*.sqlite3
storage/*.db

# Keep generated directories in a fresh clone
!storage/data/.gitkeep
!storage/reports/.gitkeep

# Editors and macOS
.DS_Store
.idea/
.vscode/
